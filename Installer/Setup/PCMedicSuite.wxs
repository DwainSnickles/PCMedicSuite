<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="PC Medic Suite"
           Manufacturer="DwainSnickles"
           Version="1.5.1.0"
           UpgradeCode="68F2C8A7-EF89-40D8-A743-0B1A061DAD4A"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of PC Medic Suite is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PC Medic Suite" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="PC Medic Suite" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
    </Feature>

    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

  </Package>
</Wix>
